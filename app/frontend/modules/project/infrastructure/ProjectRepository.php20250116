<?php

namespace app\frontend\modules\project\infrastructure;

use app\common\exceptions\ShopException;
use app\common\models\BaseModel;
use app\common\models\MemberCart;
use app\frontend\modules\coupon\models\Goods;
use app\frontend\modules\project\models\Project;
use app\frontend\modules\project\repositories\ProjectRepositoryInterface;
use app\frontend\modules\project\models\FloorSpace;
use app\frontend\modules\project\models\Floors;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Redis;

class ProjectRepository extends BaseRepository implements ProjectRepositoryInterface
{

    public function __construct(Project $model)
    {
        parent::__construct($model);
    }


    /**
     * 创建项目，包括楼层和空间
     * @param array $data
     * @return bool
     */
    public function createProject(array $data): int
    {
        $requestData = $data['project'];

        if (!$requestData) {
            throw new ShopException("不合法的参数");
        }

        return $this->transaction(function () use ($requestData) {
            // 创建项目
            $projectData = [
                'member_id' => \YunShop::app()->getMemberId(),
                'uniacid' => \YunShop::app()->uniacid,
                'name' => $requestData['name'],
                'status' => $requestData['status'],
            ];

            $project = $this->save($projectData);

            // 创建楼层及其对应的空间
            if (!empty($requestData['floors'])) {
                foreach ($requestData['floors'] as $key=> $floor) {
                    $floorData = [
                        'project_id' => $project->id,
                        'name' => $floor['name'],
                        'sort'=>$key
                    ];
                    $floorModel = Floors::create($floorData);

                    if (!empty($floor['spaces'])) {
                        foreach ($floor['spaces'] as $k=> $space) {
                            $spaceData = [
                                'project_id' => $project->id,
                                'floor_id' => $floorModel->id,
                                'name' => $space['name'],
                                'sort' => $k,
                            ];
                            FloorSpace::create($spaceData);
                        }
                    }else{
                        throw new ShopException("空间必须");
                    }
                }
            }else{
                throw new ShopException("楼层必须");
            }

            return $project->id;
        });
    }

    private function isJson($string)
    {
        json_decode($string);
        return (json_last_error() == JSON_ERROR_NONE);
    }


    public function editProject(array $data): bool
    {


        $requestData = $data['project'];



        if (!$requestData) {
            throw new ShopException("不合法的参数");
        }
        return $this->transaction(function () use ($requestData) {
            $projectModel = Project::find($requestData['id']);
            if (!$projectModel) {
                throw new ShopException("没有找到项目");
            }

            $projectModel->name = $requestData['name'];
            $projectModel->status = $requestData['status'];
            $projectModel->save();  // 更新项目
            $floorsIds = [];
            if (!empty($requestData['floors'])) {
                // 处理楼层的增删改
                foreach ($requestData['floors'] as $key=> $floorData) {
                    //获取楼层所有空间

                    $floor = $this->updateOrCreateFloor($projectModel, $floorData,$key);
                    $floorsIds[] = $floor->id;

                    // 处理该楼层下的空间
                    $spacesIds = $this->updateOrCreateSpaces($floor, $floorData['spaces']);

                    // 删除不在请求中的空间
                    FloorSpace::where('floor_id', $floor->id)
                        ->whereNotIn('id', $spacesIds)
                        ->delete();
                }

                // 删除不在请求中的楼层
                $this->deleteUnusedFloors($projectModel, $floorsIds);
            }

            // 更新缓存或其他操作
            $this->updateActivateCache(\YunShop::app()->getMemberId(), $projectModel->id);

            return true;

        });

    }

    public function getFloors(int $project_id): array
    {
        $member_id = \YunShop::app()->getMemberId();
        $project = Project::getProject($project_id, $member_id);
        if (!$project) {
            throw new ShopException("项目不存在");
        }
        $list = Floors::select("id", "name")->where('project_id', $project_id)->get();
        if ($list) {
            return $list->toArray();
        }
        return [];
    }



    public function switchActiveProject(int $project_id, int $floor_id = null, int $space_id = null): bool
    {
        $member_id = \YunShop::app()->getMemberId();
        DB::beginTransaction(); // 开始事务
        try {
            $project = Project::getProject($project_id);
            if (!$project) {
                DB::rollBack();
                throw new ShopException("未找到该项目");
            }
            //更新当前项目为激活状态
            $project->activate = 1;
            $project->save();

            //获取该项目的第一个楼层和第一个空间（如果是首次激活）
            if (is_null($floor_id) && is_null($space_id)) {
                // 如果没有提供 floor_id 和 space_id，则默认选择第一个楼层和空间
                $firstFloor = Floors::getFirstFloor($project_id);
                if (!$firstFloor) {
                    DB::rollBack();
                    throw new ShopException('该项目没有楼层');
                }

                $firstSpace = FloorSpace::getFirstSpace($firstFloor->id);
                if (!$firstSpace) {
                    DB::rollBack();
                    throw new ShopException('该楼层没有空间');
                }

                // 设置默认激活的楼层和空间
                $floor_id = $firstFloor->id;
                $space_id = $firstSpace->id;
            }elseif(is_null($space_id) && !is_null($floor_id)){
                $firstSpace = FloorSpace::getFirstSpace($floor_id);
                if (!$firstSpace) {
                    DB::rollBack();
                    throw new ShopException('该楼层没有空间');
                }
                $space_id = $firstSpace->id;
            }elseif(!is_null($space_id) && !is_null($floor_id)){
                $floorSpace = FloorSpace::where('project_id',$project_id)->where('floor_id',$floor_id)->where('id',$space_id)->first();
                if(!$floorSpace){
                    throw new ShopException('该楼层没有此空间');
                }
            }

            // 更新楼层和空间的激活状态
            Floors::updateActivateFloor($project_id, $floor_id);

            FloorSpace::updateActivateSpace($floor_id, $space_id);


            Project::updateOtherActivate($project_id);
            Floors::updateOtherActivate($project_id, $floor_id);
            FloorSpace::updateOtherActivate($project_id, $space_id);

            //查询当前激活的项目更新缓存
            $this->updateActivateCache($member_id,$project_id);
            DB::commit(); // 提交事务
            return true;
        } catch (\Exception $e) {
            DB::rollBack(); // 回滚事务
            throw new ShopException($e->getMessage());
        }
    }


    public function getActiveProject():array
    {
        $member_id = \YunShop::app()->getMemberId();
        $cachedProjectData = Redis::get("user:{$member_id}:active_project");

        if ($cachedProjectData) {
            // 如果缓存中存在数据，直接返回
            return json_decode($cachedProjectData, true);
        }

        // 如果缓存没有，查询数据库并缓存结果
        $projectId = Project::where('member_id', $member_id)
            ->where('activate', 1)
            ->value('id');
        if($projectId){
            return $this->updateActivateCache($member_id,$projectId);
        }

        return [];
    }


    public function getMyProject(): array
    {
       $member_id = \YunShop::app()->getMemberId();
       $list = Project::select("id","name","activate","status")->where("member_id",$member_id)->orderBy('created_at','desc')->get();
       if($list){
           return $list->toArray();
       }else{
           return [];
       }

    }

    public function logout(int $project_id): bool
    {
        try{
            $project = Project::getProject($project_id);
            if(!$project){
                throw new ShopException("未找到项目");
            }
            $member_id = \YunShop::app()->getMemberId();
            Project::where('id', $project_id)
                ->where('activate', 1)
                ->update(['activate' => 0]);
            Floors::where('project_id', $project_id)
                ->where('activate', 1)
                ->update(['activate' => 0]);
            FloorSpace::where('project_id', $project_id)
                ->where('activate', 1)
                ->update(['activate' => 0]);
            Redis::del("user:{$member_id}:active_project");
            return true;
        }catch (\Exception $e){
            throw new ShopException("退出失败");
        }

    }

    public function createFloor(int $project_id, string $floor_name): array
    {
        $project = Project::getProject($project_id);
        if (!$project) {
            throw new ShopException("未找到该项目");
        }
        if (!$floor_name) {
            throw new ShopException("请输入楼层名称");
        }
        $Floors = new Floors();
        $space_data['project_id'] = $project->id;
        $space_data['name'] = $floor_name;
        $Floors->fill($space_data);
        $validator = $Floors->validator();
        if ($validator->fails()) {
            throw new ShopException($validator->messages());
        }
        if ($Floors->save()) {
            //增加空间名称
            $space_data['project_id'] = $project->id;
            $space_data['floor_id'] = $Floors->id;
            $space_data['name'] = "未命名空间";
            $space = FloorSpace::create($space_data);
            $this->updateActivateCache(\YunShop::app()->getMemberId(),$project->id);
            return ['floor_id'=>$Floors->id,'space_id'=>$space->id];
        } else {
            throw new ShopException("创建楼层失败");
        }
    }






