    /**
     * 处理楼层下空间的增删改
     * @param Floors $floor
     * @param array $spacesData
     * @return array
     */
    private function updateOrCreateSpaces(Floors $floor, array $spacesData): array
    {
        $spacesIds = [];
        //获取楼层所有空间
        $space_all = FloorSpace::where('floor_id', $floor->id)->pluck("id")->all();
        foreach ($spacesData as $k => $spaceData) {

            $space = FloorSpace::find($spaceData['id']);

            if ($space) {
                //不在这个楼层说明是移动过来的空间
                if (!in_array($spaceData['id'], $space_all)) {
                    $space->floor_id = $floor->id;
                }
                // 更新空间
                $space->name = $spaceData['name'];
                $space->sort = $k;
                $space->save();
            } else {
                // 新增空间
                if (empty($spaceData['name'])) {
                    throw new ShopException("请填入空间名称");
                }

                $spaceDataNew = [
                    'project_id' => $floor->project_id,
                    'floor_id' => $floor->id,
                    'name' => $spaceData['name'],
                    'sort' => $k,
                ];
                $space = FloorSpace::create($spaceDataNew);
            }

            $spacesIds[] = $space->id;
        }

        return $spacesIds;
    }

    /**
     * 删除不在请求中的楼层
     * @param Project $projectModel
     * @param array $floorsIds
     */
    private function deleteUnusedFloors(Project $projectModel, array $floorsIds)
    {
        Floors::where('project_id', $projectModel->id)
            ->whereNotIn('id', $floorsIds)
            ->get()
            ->each(function ($floor) {
                $floor->spaces()->delete(); // 删除该楼层下的所有空间
                $floor->delete(); // 删除楼层
            });
    }



    protected function addGoodsSpaceBatch(array $list)
    {


        if (empty($list)) {
            return;
        }

        // 获取所有option_id
        $optionIds = array_column($list, 'option_id');
        $optionIds = array_filter(array_unique($optionIds)); // 去重并过滤空值

        // 一次性查询所有GoodsOptionModel数据
        $options = GoodsOptionModel::whereIn('option_id', $optionIds)
            ->select(['id', 'default_color'])
            ->get()
            ->groupBy('option_id') // 按id分组，处理一个option_id对应多条记录的情况
            ->toArray();

        $insertList = [];

        foreach ($list as $data) {

            $optionId = $data['option_id'] ?: 0;
            $components = [];

            if ($optionId && isset($options[$optionId])) {
                // 遍历该option_id对应的所有记录
                foreach ($options[$optionId] as $option) {
                    // 反序列化default_color
                    $defaultColor = unserialize($option['default_color']);

                    // 如果反序列化失败，设置为空数组
                    if ($defaultColor === false) {
                        $defaultColor = [];
                    }

                    // 添加到components数组
                    $components[] = [
                        "color_id" => $defaultColor['id'] ?? 3,
                        "component_id" => $option['id'] ?: 4,
                    ];
                }
            }

            // 如果没有找到任何option记录，添加默认组件
            if (empty($components)) {
                $components[] = [
                    "color_id" => 3,
                    "component_id" => 4,
                ];
            }
            $data['components'] = $components;
            $data['components'] = json_encode($data['components'], JSON_UNESCAPED_UNICODE);
            $new_data = array(
                'member_id' => \YunShop::app()->getMemberId(),
                'uniacid' => \YunShop::app()->uniacid,
                'project_id' => $data['project_id'],  //项目id
                'space_id' => $data['space_id'],  //空间id
                'floor_id' => $data['floor_id'],  //楼层id
                'goods_id' => $data['goods_id'],
                'total' => $data['total'],
                'option_id' => $data['option_id'] ?: 0,
                'components' => $data['components'],
                'components_hash' => md5($data['components'])
            );

            $insertList[] = $new_data;
        }

        MemberCart::insert($insertList);
    }

