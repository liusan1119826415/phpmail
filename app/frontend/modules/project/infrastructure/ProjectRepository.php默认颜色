    protected function handleGoods($cartList)
    {
        if ($cartList) {
            $cartList = $cartList->toArray();
            $total_price = 0;
            $total_num = 0;
            $newList = [];
            foreach ($cartList as $key => $item) {
                $newList[$key]['id'] = $item['id'];
                $newList[$key]['goods_id'] = $item['goods_id'];
                $newList[$key]['thumb'] = yz_tomedia($item['goods_option']['thumb']);
                $total_num += $item['total'];
                $total_price += $item['total'] * $item['goods_option']['market_price'];


            }

            return ['goods' => $newList, 'total_num' => $total_num, 'total_price' => $this->truncate_to_two_decimals($total_price)];
        }

        return [];

    }







