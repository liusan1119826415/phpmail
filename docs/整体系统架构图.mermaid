flowchart TB
    subgraph Client["🖥️ 客户端"]
        User["👤 用户端访问家具商城"]
        Admin["🖥️ 后台上传商品"]
        CS_User["💬 用户端客服入口"]
    end

    subgraph Gateway["🌐 网关层"]
        Nginx["Nginx 反向代理"]
    end

    subgraph Frontend["🎨 前端层"]
        SSR["前端 SSR 渲染"]
    end

    subgraph Backend["⚙️ 后端层"]
        PHP["PHP-FPM<br/>(核心服务接口)"]
        Job["定时任务<br/>(每天同步 Meilisearch)"]
    end

    subgraph Search["🔍 搜索服务层"]
        Meili["Meilisearch<br/>(商品搜索)"]
    end

    subgraph CustomerService["🎧 客服系统层"]
        CS_Core["客服系统核心<br/>(消息/会话/工单)"]
        CS_Socket["WebSocket 服务<br/>(实时消息)"]
    end

    subgraph Services["🧩 业务服务层"]
        SearchImg["Python<br/>以图搜图服务"]
        subgraph Server124["服务器: 116.62.116.124"]
            CAD["Node.js<br/>CAD图纸解析"]
            Model3D["Python<br/>3D模型检测"]
        end
    end

    subgraph Storage["💾 存储层"]
        DB[(主数据库)]
        CS_DB[(客服数据库)]
        OSS[(对象存储 OSS)]
        Redis[("Redis<br/>(会话/缓存)")]
    end

    %% ==================== 家具商城核心链路 ====================
    %% 用户访问商城
    User --> Nginx
    Nginx --> SSR
    SSR --> PHP
    PHP --> Meili
    PHP --> DB

    %% 后台上传商品 + 实时更新 Meili
    Admin --> Nginx
    Nginx --> PHP
    PHP --> DB
    PHP -->|实时更新索引| Meili

    %% 定时任务同步 Meili
    Job -->|每天同步| Meili
    Job --> DB

    %% 业务服务调用
    PHP --> SearchImg
    PHP --> CAD
    PHP --> Model3D

    %% ==================== 客服系统链路 ====================
    %% 用户端客服入口
    CS_User --> Nginx
    Nginx --> PHP
    PHP --> CS_Core
    PHP --> CS_Socket

    %% 客服系统内部调用
    CS_Core --> CS_DB
    CS_Core --> Redis
    CS_Socket --> Redis
    CS_Core --> CS_Socket

    %% 客服消息中的文件/图片存储
    CS_Core --> OSS

    %% 商城与客服联动（可选）
    PHP --> CS_Core

    %% ==================== 存储层公共 ====================
    PHP --> OSS
    CAD --> OSS
    Model3D --> OSS
    Model3D --> DB
    SearchImg --> OSS